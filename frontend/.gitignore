```gitignore
# Dependencies
node_modules/
**/node_modules/

# Build files
dist/
dist-ssr/
build/
coverage/

# Environment variables
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local files
*.local

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Other files
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
```